{
  "name": "laughing-fortnight",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @laughing-fortnight/student",
    "build": "npm run build -w @laughing-fortnight/student",
    "typecheck": "tsc -p apps/student && tsc -p packages/ui",
    "test": "npm run test:guard && npm run test:unit",
    "test:guard": "node --test \"apps/**/test/**/*.test.ts\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run check:build && npm run test:e2e",
    "check:build": "npm run build && node scripts/check-build.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
